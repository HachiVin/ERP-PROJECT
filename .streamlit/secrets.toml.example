# Copy this file to .streamlit/secrets.toml for local runs, or paste its contents into
# Streamlit Community Cloud > Manage app > Settings > Secrets.
# The real secrets.toml is git-ignored. Never commit real keys or hashes.

[users]
# One line per account: username = "<bcrypt hash>". See README, "Create a login".
demo = "$2b$12$REPLACE_WITH_A_REAL_BCRYPT_HASH"

[openrouter]
api_key = "sk-or-REPLACE_ME"
# Must end in ":free" (or be "openrouter/free"); other models are refused by the app.
model = "openai/gpt-oss-20b:free"
